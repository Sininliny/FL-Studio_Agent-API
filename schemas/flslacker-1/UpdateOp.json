{
  "$defs": {
    "NoteSet": {
      "additionalProperties": false,
      "description": "Allowlisted fields an update may change. Omitted fields are untouched.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "duration_tick": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Tick"
        },
        "fcut": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fcut"
        },
        "fres": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fres"
        },
        "muted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Muted"
        },
        "pan": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pan"
        },
        "pitch": {
          "anyOf": [
            {
              "maximum": 127,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch"
        },
        "pitchofs": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": -120,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitchofs"
        },
        "porta": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Porta"
        },
        "release": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release"
        },
        "repeats": {
          "anyOf": [
            {
              "maximum": 14,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeats"
        },
        "slide": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slide"
        },
        "start_tick": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Tick"
        },
        "velocity": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Velocity"
        }
      },
      "title": "NoteSet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "note_id": {
      "description": "Snapshot-local note id",
      "pattern": "^n[0-9]{1,5}$",
      "title": "Note Id",
      "type": "string"
    },
    "op": {
      "const": "note.update",
      "title": "Op",
      "type": "string"
    },
    "set": {
      "$ref": "#/$defs/NoteSet"
    }
  },
  "required": [
    "op",
    "note_id",
    "set"
  ],
  "title": "UpdateOp",
  "type": "object"
}
