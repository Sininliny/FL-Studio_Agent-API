{
  "$defs": {
    "DiffRow": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "changed_fields": {
          "items": {
            "type": "string"
          },
          "title": "Changed Fields",
          "type": "array"
        },
        "client_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.-]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "kind": {
          "enum": [
            "update",
            "insert",
            "delete"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note_id": {
          "anyOf": [
            {
              "description": "Snapshot-local note id",
              "pattern": "^n[0-9]{1,5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note Id"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "DiffRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "after_content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "After Content Hash",
      "type": "string"
    },
    "after_snapshot_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "After Snapshot Id",
      "type": "string"
    },
    "after_state_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "After State Hash",
      "type": "string"
    },
    "applied_operation_count": {
      "title": "Applied Operation Count",
      "type": "integer"
    },
    "before_snapshot_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Before Snapshot Id",
      "type": "string"
    },
    "before_state_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Before State Hash",
      "type": "string"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/DiffRow"
      },
      "title": "Changes",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Job Id",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Plan Id",
      "type": "string"
    },
    "receipt_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "recovery_available": {
      "title": "Recovery Available",
      "type": "boolean"
    },
    "recovery_note": {
      "title": "Recovery Note",
      "type": "string"
    },
    "target_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Target Id",
      "type": "string"
    },
    "target_label": {
      "title": "Target Label",
      "type": "string"
    },
    "verification": {
      "const": "verified",
      "title": "Verification",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "job_id",
    "plan_id",
    "plan_hash",
    "target_id",
    "target_label",
    "before_snapshot_id",
    "before_state_hash",
    "after_snapshot_id",
    "after_state_hash",
    "after_content_hash",
    "applied_operation_count",
    "verification",
    "recovery_available",
    "recovery_note",
    "changes",
    "created_at"
  ],
  "title": "Receipt",
  "type": "object"
}
