{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "required_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequiredAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "JobEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "at"
      ],
      "title": "JobEvent",
      "type": "object"
    },
    "RequiredAction": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "enum": [
            "user",
            "agent"
          ],
          "title": "Actor",
          "type": "string"
        },
        "instruction": {
          "title": "Instruction",
          "type": "string"
        },
        "request_short_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Short Id"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "where": {
          "enum": [
            "fl_piano_roll",
            "companion_ui",
            "agent"
          ],
          "title": "Where",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "where",
        "instruction"
      ],
      "title": "RequiredAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/JobEvent"
      },
      "title": "History",
      "type": "array"
    },
    "job_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Job Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "capture",
        "apply"
      ],
      "title": "Kind",
      "type": "string"
    },
    "next_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/RequiredAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parent_job_id": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Job Id"
    },
    "plan_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Hash"
    },
    "plan_id": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Id"
    },
    "purpose": {
      "enum": [
        "capture",
        "verify",
        "apply",
        "restore"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "receipt_id": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt Id"
    },
    "request_short_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Short Id"
    },
    "scope": {
      "anyOf": [
        {
          "enum": [
            "selected",
            "all_exposed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "session_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "state": {
      "enum": [
        "queued",
        "awaiting_fl_action",
        "validating",
        "applying",
        "awaiting_verification",
        "applied",
        "completed",
        "cancelled",
        "expired",
        "failed",
        "outcome_unknown",
        "partial_apply",
        "verification_failed"
      ],
      "title": "State",
      "type": "string"
    },
    "target_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Label"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "verify_job_id": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verify Job Id"
    }
  },
  "required": [
    "job_id",
    "kind",
    "purpose",
    "state",
    "session_id",
    "created_by",
    "created_at",
    "updated_at",
    "expires_at"
  ],
  "title": "Job",
  "type": "object"
}
