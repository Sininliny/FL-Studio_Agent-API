{
  "$defs": {
    "NoteTemplate": {
      "additionalProperties": false,
      "description": "A new note. Omitted optional fields are filled from the captured default note.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "maximum": 15,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "duration_tick": {
          "minimum": 1,
          "title": "Duration Tick",
          "type": "integer"
        },
        "fcut": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fcut"
        },
        "fres": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fres"
        },
        "group": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "muted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Muted"
        },
        "pan": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pan"
        },
        "pitch": {
          "maximum": 127,
          "minimum": 0,
          "title": "Pitch",
          "type": "integer"
        },
        "pitchofs": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": -120,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitchofs"
        },
        "porta": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Porta"
        },
        "release": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release"
        },
        "repeats": {
          "anyOf": [
            {
              "maximum": 14,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeats"
        },
        "selected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected"
        },
        "slide": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slide"
        },
        "start_tick": {
          "minimum": 0,
          "title": "Start Tick",
          "type": "integer"
        },
        "velocity": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Velocity"
        }
      },
      "required": [
        "pitch",
        "start_tick",
        "duration_tick"
      ],
      "title": "NoteTemplate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_id": {
      "pattern": "^[A-Za-z0-9_.-]{1,40}$",
      "title": "Client Id",
      "type": "string"
    },
    "note": {
      "$ref": "#/$defs/NoteTemplate"
    },
    "op": {
      "const": "note.insert",
      "title": "Op",
      "type": "string"
    }
  },
  "required": [
    "op",
    "client_id",
    "note"
  ],
  "title": "InsertOp",
  "type": "object"
}
