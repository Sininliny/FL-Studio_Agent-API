{
  "$defs": {
    "DiffRow": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "changed_fields": {
          "items": {
            "type": "string"
          },
          "title": "Changed Fields",
          "type": "array"
        },
        "client_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.-]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "kind": {
          "enum": [
            "update",
            "insert",
            "delete"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note_id": {
          "anyOf": [
            {
              "description": "Snapshot-local note id",
              "pattern": "^n[0-9]{1,5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note Id"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "DiffRow",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "required_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequiredAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "Job": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/JobEvent"
          },
          "title": "History",
          "type": "array"
        },
        "job_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "capture",
            "apply"
          ],
          "title": "Kind",
          "type": "string"
        },
        "next_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequiredAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Job Id"
        },
        "plan_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Hash"
        },
        "plan_id": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "purpose": {
          "enum": [
            "capture",
            "verify",
            "apply",
            "restore"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "receipt_id": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt Id"
        },
        "request_short_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Short Id"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "selected",
                "all_exposed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "session_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "state": {
          "enum": [
            "queued",
            "awaiting_fl_action",
            "validating",
            "applying",
            "awaiting_verification",
            "applied",
            "completed",
            "cancelled",
            "expired",
            "failed",
            "outcome_unknown",
            "partial_apply",
            "verification_failed"
          ],
          "title": "State",
          "type": "string"
        },
        "target_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Label"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "verify_job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verify Job Id"
        }
      },
      "required": [
        "job_id",
        "kind",
        "purpose",
        "state",
        "session_id",
        "created_by",
        "created_at",
        "updated_at",
        "expires_at"
      ],
      "title": "Job",
      "type": "object"
    },
    "JobEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "at"
      ],
      "title": "JobEvent",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "after_content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "After Content Hash",
          "type": "string"
        },
        "after_snapshot_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "After Snapshot Id",
          "type": "string"
        },
        "after_state_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "After State Hash",
          "type": "string"
        },
        "applied_operation_count": {
          "title": "Applied Operation Count",
          "type": "integer"
        },
        "before_snapshot_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Before Snapshot Id",
          "type": "string"
        },
        "before_state_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Before State Hash",
          "type": "string"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/DiffRow"
          },
          "title": "Changes",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "job_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Job Id",
          "type": "string"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "plan_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Plan Id",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "recovery_available": {
          "title": "Recovery Available",
          "type": "boolean"
        },
        "recovery_note": {
          "title": "Recovery Note",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Target Id",
          "type": "string"
        },
        "target_label": {
          "title": "Target Label",
          "type": "string"
        },
        "verification": {
          "const": "verified",
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "job_id",
        "plan_id",
        "plan_hash",
        "target_id",
        "target_label",
        "before_snapshot_id",
        "before_state_hash",
        "after_snapshot_id",
        "after_state_hash",
        "after_content_hash",
        "applied_operation_count",
        "verification",
        "recovery_available",
        "recovery_note",
        "changes",
        "created_at"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "RequiredAction": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "enum": [
            "user",
            "agent"
          ],
          "title": "Actor",
          "type": "string"
        },
        "instruction": {
          "title": "Instruction",
          "type": "string"
        },
        "request_short_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Short Id"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "where": {
          "enum": [
            "fl_piano_roll",
            "companion_ui",
            "agent"
          ],
          "title": "Where",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "where",
        "instruction"
      ],
      "title": "RequiredAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "job": {
      "$ref": "#/$defs/Job"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Receipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "job"
  ],
  "title": "JobView",
  "type": "object"
}
